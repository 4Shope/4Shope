rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function admin() {
      return request.auth != null && request.auth.uid == 'h8B5xEGJYSV5sBUMgfAyfPtc40j2';
    }
    match /products/{id} {
      allow get, list: if admin() || resource.data.published == true;
      allow create, update, delete: if admin();
    }
    match /categories/{id} {
      allow read: if true;
      allow write: if admin();
    }
    match /settings/{id} {
      allow read: if id == 'public';
      allow write: if admin() && id == 'public';
    }
    // Contadores agregados publicos: apenas incrementos unitarios nos produtos publicados.
    // Observacao: regras nao impedem bots de simular cliques. Nao sao vendas.
    match /productStatsMonthly/{id} {
      allow read: if admin();
      function validBase() {
        return request.resource.data.keys().hasOnly(['productId','month','views','buys'])
          && request.resource.data.keys().hasAll(['productId','month','views','buys'])
          && request.resource.data.productId is string
          && request.resource.data.productId.matches('^[a-zA-Z0-9_-]{1,100}$')
          && request.resource.data.month is string
          && request.resource.data.month.matches('^20[0-9]{4}$')
          && id == request.resource.data.productId + '_' + request.resource.data.month
          && exists(/databases/$(database)/documents/products/$(request.resource.data.productId))
          && get(/databases/$(database)/documents/products/$(request.resource.data.productId)).data.published == true
          && request.resource.data.views is int
          && request.resource.data.buys is int;
      }
      allow create: if validBase()
        && ((request.resource.data.views == 1 && request.resource.data.buys == 0)
           || (request.resource.data.views == 0 && request.resource.data.buys == 1));
      allow update: if validBase()
        && request.resource.data.productId == resource.data.productId
        && request.resource.data.month == resource.data.month
        && ((request.resource.data.views == resource.data.views + 1 && request.resource.data.buys == resource.data.buys)
           || (request.resource.data.views == resource.data.views && request.resource.data.buys == resource.data.buys + 1));
      allow delete: if admin();
    }
    match /analyticsEvents/{id} {
      allow get, list, delete: if admin();
      allow create: if request.resource.data.keys().hasOnly(['productId','type','createdAt'])
        && request.resource.data.keys().hasAll(['productId','type','createdAt'])
        && request.resource.data.productId is string
        && request.resource.data.productId.size() > 0
        && request.resource.data.productId.size() <= 100
        && request.resource.data.productId.matches('^[a-zA-Z0-9_-]+$')
        && request.resource.data.type in ['visit','view','buy','share','ad','adView']
        && request.resource.data.createdAt is int
        && request.resource.data.createdAt >= request.time.toMillis() - 600000
        && request.resource.data.createdAt <= request.time.toMillis() + 600000;
      allow update: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}